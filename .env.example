# Server
PORT=8080
APP_ENV=development   # development | production

# PostgreSQL (Render free tier)
DATABASE_URL=postgres://user:password@host:5432/notifyx?sslmode=require

# Redis (Upstash free tier)
REDIS_URL=rediss://default:password@host:6379

# Kafka (Confluent Cloud free tier)
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.aws.confluent.cloud:9092
KAFKA_API_KEY=your_confluent_api_key
KAFKA_API_SECRET=your_confluent_api_secret

# Email (Resend — 100/day free)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Push (Firebase FCM — free)
FIREBASE_CREDENTIALS_JSON=path/to/serviceAccountKey.json

# SMS (Fast2SMS — free tier, India)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Rate Limiting Defaults (used when tenant has no custom config)
DEFAULT_RATE_LIMIT_PER_MIN=60
DEFAULT_GLOBAL_CAP=300
